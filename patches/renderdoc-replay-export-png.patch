+// Select the final presented image after executing the captured commands. This
+// deliberately does not use ICaptureFile::GetThumbnail(), which never replays.
+static void FindReplayOutput(const rdcarray<ActionDescription> &actions, uint32_t &lastEvent,
+                             uint32_t &workCount, uint32_t &rayCount, ResourceId &output)
+{
+  for(const ActionDescription &action : actions)
+  {
+    lastEvent = std::max(lastEvent, action.eventId);
+    if(action.flags & (ActionFlags::Drawcall | ActionFlags::Dispatch | ActionFlags::DispatchRay |
+                       ActionFlags::MeshDispatch))
+    {
+      workCount++;
+      if(action.flags & ActionFlags::DispatchRay)
+        rayCount++;
+      if(action.outputs[0] != ResourceId())
+        output = action.outputs[0];
+    }
+    if(action.flags & ActionFlags::Present && action.copyDestination != ResourceId())
+      output = action.copyDestination;
+    FindReplayOutput(action.children, lastEvent, workCount, rayCount, output);
+  }
+}
+
+static int ExportReplayPNG(IReplayController *renderer, const std::string &filename)
+{
+  uint32_t lastEvent = 0, workCount = 0, rayCount = 0;
+  ResourceId output;
+  FindReplayOutput(renderer->GetRootActions(), lastEvent, workCount, rayCount, output);
+  if(workCount == 0)
+  {
+    std::cerr << "Capture contains no draw, compute dispatch, or ray dispatch; "
+                 "cannot export a rendered frame."
+              << std::endl;
+    return 1;
+  }
+  renderer->SetFrameEvent(lastEvent, true);
+  ResultDetails fatal = renderer->GetFatalErrorStatus();
+  if(!fatal.OK())
+  {
+    std::cerr << "Replay failed: " << fatal.Message() << std::endl;
+    return 1;
+  }
+  if(filename.empty())
+  {
+    std::cout << "Replayed through event " << lastEvent << " (" << workCount
+              << " draw/dispatch actions, " << rayCount << " ray dispatches)." << std::endl;
+    return 0;
+  }
+  if(output == ResourceId())
+  {
+    for(const TextureDescription &texture : renderer->GetTextures())
+      if(texture.creationFlags & TextureCategory::SwapBuffer)
+      {
+        output = texture.resourceId;
+        break;
+      }
+  }
+  if(output == ResourceId())
+  {
+    std::cerr << "Capture has no presented image or colour attachment to export." << std::endl;
+    return 1;
+  }
+
+  TextureSave save;
+  save.resourceId = output;
+  save.destType = FileType::PNG;
+  save.mip = 0;
+  save.slice.sliceIndex = 0;
+  save.alpha = AlphaMapping::Discard;
+  ResultDetails result = renderer->SaveTexture(save, conv(filename));
+  fatal = renderer->GetFatalErrorStatus();
+  if(!fatal.OK())
+  {
+    std::cerr << "Replay readback failed: " << fatal.Message() << std::endl;
+    return 1;
+  }
+  if(!result.OK())
+  {
+    std::cerr << "Couldn't export replayed image: " << result.Message() << std::endl;
+    return 1;
+  }
+  std::cout << "Replayed through event " << lastEvent << " (" << workCount
+            << " draw/dispatch actions, " << rayCount << " ray dispatches); wrote '"
+            << filename << "'." << std::endl;
+  return 0;
+}
