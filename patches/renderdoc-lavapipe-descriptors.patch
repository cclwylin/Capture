+  for(uint32_t i = 0; i < samplerCount; i++)
+  {
+    if(pSamplers && pSamplers[i].pNext)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+    VkResult ret = ObjDisp(device)->WriteSamplerDescriptorsEXT(Unwrap(device), 1,
+                                                              pSamplers ? &pSamplers[i] : NULL,
+                                                              &pDescriptors[i]);
+    if(ret != VK_SUCCESS) return ret;
+    if(IsCaptureMode(m_State))
+    {
+      CACHE_THREAD_SERIALISER();
+      SCOPED_SERIALISE_CHUNK(VulkanChunk::vkWriteSamplerDescriptorsEXT);
+      Serialise_vkWriteSamplerDescriptorsEXT(ser, device, 1, pSamplers ? &pSamplers[i] : NULL,
+                                             &pDescriptors[i]);
+      GetRecord(device)->AddChunk(scope.Get());
+    }
+  }
+  return VK_SUCCESS;
+}
+
+template <typename SerialiserType>
+bool WrappedVulkan::Serialise_vkWriteResourceDescriptorsEXT(
+    SerialiserType &ser, VkDevice device, uint32_t resourceCount,
+    const VkResourceDescriptorInfoEXT *pResources, const VkHostAddressRangeEXT *pDescriptors)
+{
+  SERIALISE_ELEMENT(device);
+  SERIALISE_ELEMENT_LOCAL(type, pResources ? pResources[0].type : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE);
+  VkResourceDescriptorInfoEXT info = {VK_STRUCTURE_TYPE_RESOURCE_DESCRIPTOR_INFO_EXT};
+  VkImageDescriptorInfoEXT image = {VK_STRUCTURE_TYPE_IMAGE_DESCRIPTOR_INFO_EXT};
+  VkImageViewCreateInfo view = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+  VkTexelBufferDescriptorInfoEXT texel = {VK_STRUCTURE_TYPE_TEXEL_BUFFER_DESCRIPTOR_INFO_EXT};
+  VkDeviceAddressRangeEXT range = {};
+  bool hasData = false;
+  bytebuf captured;
+  if(ser.IsWriting())
+  {
+    info = pResources[0];
+    hasData = info.data.pImage != NULL;
+    size_t size = size_t(vkGetPhysicalDeviceDescriptorSizeEXT(GetPhysDev(), type));
+    captured.assign((byte *)pDescriptors[0].address, size);
+    if(hasData)
+    {
+      if(type == VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE || type == VK_DESCRIPTOR_TYPE_STORAGE_IMAGE ||
+         type == VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT)
+      {
+        image = *info.data.pImage;
+        hasData = image.pView != NULL;
+        if(hasData) view = *image.pView;
+      }
+      else if(type == VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER || type == VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER)
+        texel = *info.data.pTexelBuffer;
+      else
+        range = *info.data.pAddressRange;
+    }
+  }
+  SERIALISE_ELEMENT(hasData);
+  if(type == VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE || type == VK_DESCRIPTOR_TYPE_STORAGE_IMAGE ||
+     type == VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT)
+  {
+    SERIALISE_ELEMENT(view);
+    SERIALISE_ELEMENT_LOCAL(layout, image.layout);
+    image.layout = layout;
+    image.pView = hasData ? &view : NULL;
+    info.data.pImage = &image;
+  }
+  else if(type == VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER || type == VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER)
+  {
+    SERIALISE_ELEMENT_LOCAL(format, texel.format);
+    SERIALISE_ELEMENT_LOCAL(address, texel.addressRange.address).GPUAddress();
+    SERIALISE_ELEMENT_LOCAL(size, texel.addressRange.size);
+    texel.format = format;
+    texel.addressRange = {address, size};
+    info.data.pTexelBuffer = hasData ? &texel : NULL;
+  }
+  else
+  {
+    SERIALISE_ELEMENT_LOCAL(address, range.address).GPUAddress();
+    SERIALISE_ELEMENT_LOCAL(size, range.size);
+    range = {address, size};
+    info.data.pAddressRange = hasData ? &range : NULL;
+  }
+  SERIALISE_ELEMENT(captured);
+  SERIALISE_CHECK_READ_ERRORS();
+  if(IsReplayingAndReading())
+  {
+    info.type = type;
+    view.image = Unwrap(view.image);
+    size_t size = size_t(vkGetPhysicalDeviceDescriptorSizeEXT(GetPhysDev(), type));
+    if(size != captured.size())
+    {
+      SET_ERROR_RESULT(m_FailedReplayResult, ResultCode::APIHardwareUnsupported,
+                       "Resource heap descriptor size changed");
+      return false;
+    }
+    bytebuf replayed;
+    replayed.resize(size);
+    VkHostAddressRangeEXT dst = {replayed.data(), size};
+    VkResult ret = ObjDisp(device)->WriteResourceDescriptorsEXT(Unwrap(device), 1, &info, &dst);
+    CHECK_VKR(this, ret);
+    if(ret != VK_SUCCESS) return false;
+    RememberLvpDescriptor(captured, replayed);
+  }
+  return true;
+}
+
+VkResult WrappedVulkan::vkWriteResourceDescriptorsEXT(
+    VkDevice device, uint32_t resourceCount, const VkResourceDescriptorInfoEXT *pResources,
+    const VkHostAddressRangeEXT *pDescriptors)
+{
+  for(uint32_t i = 0; i < resourceCount; i++)
+  {
+    if(pResources[i].pNext) return VK_ERROR_FEATURE_NOT_PRESENT;
+    VkResourceDescriptorInfoEXT real = pResources[i];
+    VkImageDescriptorInfoEXT image = {VK_STRUCTURE_TYPE_IMAGE_DESCRIPTOR_INFO_EXT};
+    VkImageViewCreateInfo view = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    VkResourceRecord *record = NULL;
+    switch(real.type)
+    {
+      case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+      case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+      case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+        if(real.data.pImage)
+        {
+          image = *real.data.pImage;
+          if(image.pNext) return VK_ERROR_FEATURE_NOT_PRESENT;
+          if(image.pView)
+          {
+            view = *image.pView;
+            if(view.pNext) return VK_ERROR_FEATURE_NOT_PRESENT;
+            record = GetRecord(view.image);
+            view.image = Unwrap(view.image);
+            image.pView = &view;
+          }
+          real.data.pImage = &image;
+        }
+        break;
+      case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+      case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+      case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+      case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+      case VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR:
+      {
+        VkDeviceAddress address = 0;
+        if(real.data.pAddressRange)
+          address = (real.type == VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER ||
+                     real.type == VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER)
+                        ? real.data.pTexelBuffer->addressRange.address : real.data.pAddressRange->address;
+        ResourceId id;
+        uint64_t offset = 0;
+        GetResIDFromAddr(address, id, offset);
+        record = GetResourceManager()->GetResourceRecord(id);
+        break;
+      }
+      default: return VK_ERROR_FEATURE_NOT_PRESENT;
+    }
+    VkResult ret = ObjDisp(device)->WriteResourceDescriptorsEXT(Unwrap(device), 1, &real, &pDescriptors[i]);
+    if(ret != VK_SUCCESS) return ret;
+    if(IsCaptureMode(m_State))
+    {
+      CACHE_THREAD_SERIALISER();
+      SCOPED_SERIALISE_CHUNK(VulkanChunk::vkWriteResourceDescriptorsEXT);
+      Serialise_vkWriteResourceDescriptorsEXT(ser, device, 1, &pResources[i], &pDescriptors[i]);
+      if(!record) record = GetRecord(device);
+      record->AddChunk(scope.Get());
+      AddForcedReference(record);
+    }
+  }
+  return VK_SUCCESS;
+}
