+
+void WrappedVulkan::RememberLvpDescriptor(const bytebuf &captured, const bytebuf &replayed)
+{
+  if(captured.size() != replayed.size() || captured.empty())
+  {
+    SET_ERROR_RESULT(m_FailedReplayResult, ResultCode::APIReplayFailed,
+                     "Lavapipe descriptor size changed during regeneration");
+    return;
+  }
+  for(const auto &pattern : m_LvpDescriptorPatterns)
+  {
+    if(pattern.first == captured)
+    {
+      if(pattern.second != replayed)
+        SET_ERROR_RESULT(m_FailedReplayResult, ResultCode::APIReplayFailed,
+                         "One captured descriptor regenerated with conflicting byte patterns");
+      return;
+    }
+  }
+  m_LvpDescriptorPatterns.push_back(make_rdcpair(captured, replayed));
+  std::stable_sort(m_LvpDescriptorPatterns.begin(), m_LvpDescriptorPatterns.end(),
+                   [](const rdcpair<bytebuf, bytebuf> &a, const rdcpair<bytebuf, bytebuf> &b) {
+                     return a.first.size() > b.first.size();
+                   });
+}
+
+void WrappedVulkan::RehydrateLvpDescriptors(ResourceId memory, uint64_t offset, byte *data,
+                                            uint64_t size)
+{
+  if(!m_RehydrateDescriptors || !data || size == 0)
+    return;
+  // Descriptor buffers are the only bytes we rewrite. Image contents and ordinary
+  // data buffers must remain untouched, even if they contain a matching pattern.
+  const uint64_t usages = VK_BUFFER_USAGE_RESOURCE_DESCRIPTOR_BUFFER_BIT_EXT |
+                          VK_BUFFER_USAGE_SAMPLER_DESCRIPTOR_BUFFER_BIT_EXT |
+                          VK_BUFFER_USAGE_DESCRIPTOR_HEAP_BIT_EXT;
+  uint64_t replaced = 0;
+  for(const auto &entry : m_CreationInfo.m_Buffer)
+  {
+    const auto &buffer = entry.second;
+    if(buffer.boundMemory != memory || !(buffer.usage & usages))
+      continue;
+    uint64_t begin = RDCMAX(offset, buffer.boundMemoryOffset);
+    uint64_t end = RDCMIN(offset + size, buffer.boundMemoryOffset + buffer.size);
+    for(uint64_t pos = begin; pos < end;)
+    {
+      bool found = false;
+      // Combined image/sampler patterns must precede their shorter components.
+      for(const auto &pattern : m_LvpDescriptorPatterns)
+      {
+        const uint64_t len = pattern.first.size();
+        if(len <= end - pos && memcmp(data + pos - offset, pattern.first.data(), size_t(len)) == 0)
+        {
+          memcpy(data + pos - offset, pattern.second.data(), size_t(len));
+          pos += len;
+          replaced++;
+          found = true;
+          break;
+        }
+      }
+      if(!found)
+        pos++;
+    }
+  }
+  if(replaced)
+    RDCLOG("Regenerated %llu lavapipe descriptors in memory %s", replaced, ToStr(memory).c_str());
+}
