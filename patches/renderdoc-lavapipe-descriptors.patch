+
+bool IsLvpDescriptorReplay(VkPhysicalDevice physicalDevice)
+{
+  const char *enabled = getenv("RDOC_LVP_DESCRIPTOR_REPLAY");
+  if(!enabled || strcmp(enabled, "1") != 0)
+    return false;
+  VkPhysicalDeviceDriverProperties props = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES};
+  GetPhysicalDeviceDriverProperties(ObjDisp(physicalDevice), Unwrap(physicalDevice), props);
+  return props.driverID == VK_DRIVER_ID_MESA_LLVMPIPE;
+}
