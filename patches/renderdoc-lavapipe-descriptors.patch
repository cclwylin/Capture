+template <typename SerialiserType>
+bool WrappedVulkan::Serialise_vkWriteSamplerDescriptorsEXT(
+    SerialiserType &ser, VkDevice device, uint32_t samplerCount,
+    const VkSamplerCreateInfo *pSamplers, const VkHostAddressRangeEXT *pDescriptors)
+{
+  SERIALISE_ELEMENT(device);
+  SERIALISE_ELEMENT_LOCAL(hasSampler, pSamplers != NULL);
+  VkSamplerCreateInfo sampler = {VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+  bytebuf captured;
+  if(ser.IsWriting())
+  {
+    if(hasSampler) sampler = pSamplers[0];
+    size_t size = size_t(vkGetPhysicalDeviceDescriptorSizeEXT(GetPhysDev(), VK_DESCRIPTOR_TYPE_SAMPLER));
+    captured.assign((byte *)pDescriptors[0].address, size);
+  }
+  SERIALISE_ELEMENT(sampler);
+  SERIALISE_ELEMENT(captured);
+  SERIALISE_CHECK_READ_ERRORS();
+  if(IsReplayingAndReading())
+  {
+    size_t size = size_t(vkGetPhysicalDeviceDescriptorSizeEXT(GetPhysDev(), VK_DESCRIPTOR_TYPE_SAMPLER));
+    if(size != captured.size())
+    {
+      SET_ERROR_RESULT(m_FailedReplayResult, ResultCode::APIHardwareUnsupported,
+                       "Sampler heap descriptor size changed");
+      return false;
+    }
+    bytebuf replayed;
+    replayed.resize(size);
+    VkHostAddressRangeEXT dst = {replayed.data(), size};
+    VkResult ret = ObjDisp(device)->WriteSamplerDescriptorsEXT(Unwrap(device), 1,
+                                                              hasSampler ? &sampler : NULL, &dst);
+    CHECK_VKR(this, ret);
+    if(ret != VK_SUCCESS) return false;
+    RememberLvpDescriptor(captured, replayed);
+  }
+  return true;
+}
