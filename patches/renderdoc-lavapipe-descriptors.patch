+    case VK_DESCRIPTOR_MAPPING_SOURCE_HEAP_WITH_CONSTANT_OFFSET_EXT: sampler = el.sourceData.constantOffset.pEmbeddedSampler; break;
+    case VK_DESCRIPTOR_MAPPING_SOURCE_HEAP_WITH_PUSH_INDEX_EXT: sampler = el.sourceData.pushIndex.pEmbeddedSampler; break;
+    case VK_DESCRIPTOR_MAPPING_SOURCE_HEAP_WITH_INDIRECT_INDEX_EXT: sampler = el.sourceData.indirectIndex.pEmbeddedSampler; break;
+    case VK_DESCRIPTOR_MAPPING_SOURCE_HEAP_WITH_INDIRECT_INDEX_ARRAY_EXT: sampler = el.sourceData.indirectIndexArray.pEmbeddedSampler; break;
